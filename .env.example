# ============================================================
# safe-mcp-agent — environment template
# ============================================================
# Copy to .env and adjust for your machine.
# .env is gitignored. This file is the committed reference copy.
# ============================================================

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Paths (relative to repo root; override if you moved things) ---
FIXTURES_DIR=reference_system/fixtures
TRACES_DB=traces.db

# --- Test behaviour ---
# Set to 1 to run LLM-dependent (slow) tests locally.
# CI always leaves this unset so slow tests are skipped automatically.
RUN_SLOW_TESTS=0
